<div class="page-container">
    <div class="pb-10 flex items-center flex-col" data-controller="filter-toggle">
        <h2 class="pod-page-title !mb-0">
            Payment Successful
        </h2>
        <div class="red-accent-pill-large"></div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-8 lg:mx-50 gap-6">

        <div class="flex justify-center items-center flex-col bg-dark-grey aspect-square rounded-full mx-auto lg:mx-0 w-[40%] lg:w-full">
            <%= image_tag "peak_logo_white.svg", alt: "EasyReg Logo" , class: "h-full object-contain w-[60%]" %>
        </div>

        <div class="bg-grey-custom lg:col-span-7 rounded-xl flex flex-row justify-between items-center p-7">
            <p class="text-lg">
                Your Purchase was successful!
            </p>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8 text-green-600">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
        </div>

    </div>

    <div class="lg:mx-50 rounded-xl border-1 border-gray-200 p-5 mt-6">
        <div class="grid grid-cols-8 flex items-center gap-3 mt-4">
            <%= image_tag "peak.png", class: "col-span-2 lg:col-span-1" %>
            <p class="col-span-8 lg:col-span-5">
                Peak Men Taichi 7.0 Running Shoes - WHITE/RED
            </p>
            <p class="col-span-4 lg:col-span-1">
                items(1)
            </p>
            <p class="col-span-4 lg:col-span-1">
                R99999.00
            </p>
        </div>

        <div class="flex justify-end border-t-1 border-gray-200 mt-5">
            <p class="text-xl py-2">
                <span>
                    Total
                </span>
                R9999999.00
            </p>
        </div>
    </div>
    <div class="mt-3">
        <p class="text-center">
            Payment confirmation has been set to your inbox
        </p>
    </div>
    
</div>