<div class="page-container">
    <div class="pb-10 flex items-center flex-col" data-controller="filter-toggle">
        <h2 class="pod-page-title !mb-0">
            Payment Unsuccessful
        </h2>
        <div class="red-accent-pill-large"></div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-8 lg:mx-50 gap-6">

        <div class="flex justify-center items-center flex-col bg-dark-grey aspect-square rounded-full mx-auto lg:mx-0 w-[40%] lg:w-full">
            <%= image_tag "peak_logo_white.svg", alt: "EasyReg Logo" , class: "h-full object-contain w-[60%]" %>
        </div>

        <div class="bg-grey-custom lg:col-span-7 rounded-xl flex flex-row justify-between items-center p-7">
            <p class="text-lg">
                Your Purchase failed!
            </p>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-8 text-peak-red">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>

        </div>

    </div>

    <div class="lg:mx-50 rounded-xl p-5 mt-6">
        <p class="text-center">
            Your Purchanse was Unsuccessful:
        </p>
        <p class="text-center text-peak-red">
            Reason for failed transaction 
        </p>
        
    </div>
    <div class="grid grid-cols-3 lg:mx-50 mt-6">
        <div></div>
        <div class="grid grid-cols-2 gap-3">
            <button type="button" class="col-span-2 lg:col-span-1 btn-checkout-solid cursor-pointer">
                Return To Cart
            </button>

            <button type="button" class="col-span-2 lg:col-span-1 btn-dark-checkout-outline w-full cursor-pointer">
                Retry Payment
            </button>
        </div>
        <div></div>
    </div>
    
    
</div>